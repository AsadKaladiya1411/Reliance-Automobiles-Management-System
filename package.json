{
  "name": "rams",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces",
    "verify": "npm run prisma:generate && npm run typecheck && npm run test && npm run lint && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "docker:build": "docker build -t rams-erp .",
    "docker:up": "docker compose up --build",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-database.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-database.ps1",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:deploy": "npm run prisma:deploy --workspace server"
  }
}
