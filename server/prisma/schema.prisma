  paymentDate    DateTime       @db.Date
  amount         Decimal        @db.Decimal(14, 2)
  referenceNo    String?        @db.VarChar(120)
  narration      String?        @db.VarChar(500)
  status         DocumentStatus @default(POSTED)
  postedByUserId String?        @db.Uuid
  postedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  paymentMode  PaymentMode   @relation(fields: [paymentModeId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([companyId, paymentNumber])
  @@index([companyId, partyType, paymentDate])
}

model JobCard {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  customerId        String        @db.Uuid
  vehicleId         String        @db.Uuid
  advisorEmployeeId String?       @db.Uuid
  technicianEmployeeId String?    @db.Uuid
  jobCardNumber     String        @db.VarChar(80)
  jobDate           DateTime      @db.Date
  expectedDeliveryAt DateTime?
  odometerReading   Int           @default(0)
  fuelLevel         String?       @db.VarChar(40)
  complaint         String        @db.VarChar(800)
  diagnosis         String?       @db.VarChar(800)
  workNotes         String?       @db.VarChar(800)
  status            JobCardStatus @default(OPEN)
  estimatedPartsTotal Decimal     @default(0) @db.Decimal(14, 2)
  estimatedLaborTotal Decimal     @default(0) @db.Decimal(14, 2)
  estimatedTotal    Decimal       @default(0) @db.Decimal(14, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company    Company   @relation(fields: [companyId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  advisor    Employee? @relation("JobCardAdvisor", fields: [advisorEmployeeId], references: [id])
  technician Employee? @relation("JobCardTechnician", fields: [technicianEmployeeId], references: [id])
  parts      JobCardPart[]
  laborLines JobCardLabor[]

  @@unique([companyId, jobCardNumber])
  @@index([companyId, status, jobDate])
  @@index([companyId, customerId, jobDate])
  @@index([companyId, vehicleId, jobDate])
}

model JobCardPart {
  id               String  @id @default(uuid()) @db.Uuid
  jobCardId        String  @db.Uuid
  productVariantId String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  estimatedRate    Decimal @default(0) @db.Decimal(14, 2)
  estimatedAmount  Decimal @default(0) @db.Decimal(14, 2)
  lineOrder        Int     @default(0)

  jobCard        JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([jobCardId])
}

model JobCardLabor {
  id              String  @id @default(uuid()) @db.Uuid
  jobCardId       String  @db.Uuid
  description     String  @db.VarChar(240)
  estimatedAmount Decimal @default(0) @db.Decimal(14, 2)
  lineOrder       Int     @default(0)

  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}
