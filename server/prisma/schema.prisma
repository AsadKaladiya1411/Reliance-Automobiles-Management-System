// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum FinancialYearStatus {
  OPEN
  CLOSED
  LOCKED
}

enum NumberSeriesReset {
  NEVER
  YEARLY
  MONTHLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  POST
  CANCEL
  REVERSE
}

enum ProductTrackingType {
  NONE
  BATCH
  SERIAL
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_INVOICE
  SALES_INVOICE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model Company {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(32)
  name          String       @db.VarChar(160)
  legalName     String?      @db.VarChar(200)
  gstin         String?      @unique @db.VarChar(15)
  pan           String?      @db.VarChar(10)
  tan           String?      @db.VarChar(10)
  phone         String?      @db.VarChar(32)
  email         String?      @db.VarChar(160)
  addressLine1  String?      @db.VarChar(240)
  addressLine2  String?      @db.VarChar(240)
  city          String?      @db.VarChar(120)
  state         String?      @db.VarChar(120)
  pincode       String?      @db.VarChar(12)
  country       String       @default("India") @db.VarChar(80)
  baseCurrency  String       @default("INR") @db.VarChar(3)
  timezone      String       @default("Asia/Kolkata") @db.VarChar(80)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  financialYears FinancialYear[]
  users          User[]
  roles          Role[]
  permissions    Permission[]
  numberSeries   NumberSeries[]
  auditLogs      AuditLog[]
  units          Unit[]
  hsnCodes       HsnCode[]
  taxRates       TaxRate[]
  brands         Brand[]
  categories     Category[]
  subCategories  SubCategory[]
  products       Product[]
  productVariants ProductVariant[]
  warehouses     Warehouse[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  customers      Customer[]
  suppliers      Supplier[]
  employees      Employee[]
  vehicles       Vehicle[]
  paymentModes   PaymentMode[]
}

model FinancialYear {
  id        String              @id @default(uuid()) @db.Uuid
  companyId String              @db.Uuid
  name      String              @db.VarChar(32)
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date
  status    FinancialYearStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId, status])
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  companyId            String     @db.Uuid
  username             String     @db.VarChar(80)
  email                String?    @db.VarChar(160)
  passwordHash         String     @db.VarChar(255)
  fullName             String     @db.VarChar(160)
  phone                String?    @db.VarChar(32)
  status               UserStatus @default(ACTIVE)
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  company   Company    @relation(fields: [companyId], references: [id])
  userRoles UserRole[]
  auditLogs AuditLog[] @relation("AuditActor")

  @@unique([companyId, username])
  @@unique([companyId, email])
  @@index([companyId, status])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(64)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(300)
  isSystem    Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, name])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  module      String   @db.VarChar(80)
  action      String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  createdAt   DateTime @default(now())

  company         Company          @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]

  @@unique([companyId, module, action])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model NumberSeries {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  documentType  String            @db.VarChar(80)
  prefix        String            @default("") @db.VarChar(24)
  suffix        String            @default("") @db.VarChar(24)
  padding       Int               @default(5)
  nextNumber    Int               @default(1)
  resetPolicy   NumberSeriesReset @default(YEARLY)
  financialYear String?           @db.VarChar(32)
  isDefault     Boolean           @default(true)
  status        RecordStatus      @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentType, financialYear, prefix, suffix])
  @@index([companyId, documentType, status])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  actorUserId String?     @db.Uuid
  module      String      @db.VarChar(80)
  action      AuditAction
  entityType  String      @db.VarChar(120)
  entityId    String?     @db.VarChar(80)
  description String?     @db.VarChar(500)
  beforeData  Json?
  afterData   Json?
  ipAddress   String?     @db.VarChar(64)
  userAgent   String?     @db.VarChar(300)
  createdAt   DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([companyId, module, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Unit {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  code      String       @db.VarChar(24)
  name      String       @db.VarChar(80)
  symbol    String       @db.VarChar(16)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, code])
  @@unique([companyId, name])
}

model HsnCode {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(8)
  description String       @db.VarChar(240)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  products Product[]
  taxRates TaxRate[]

  @@unique([companyId, code])
}

model TaxRate {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  hsnCodeId   String?      @db.Uuid
  name        String       @db.VarChar(80)
  cgstRate    Decimal      @default(0) @db.Decimal(5, 2)
  sgstRate    Decimal      @default(0) @db.Decimal(5, 2)
  igstRate    Decimal      @default(0) @db.Decimal(5, 2)
  cessRate    Decimal      @default(0) @db.Decimal(5, 2)
  effectiveFrom DateTime   @db.Date
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  hsnCode HsnCode? @relation(fields: [hsnCodeId], references: [id])
  products Product[]

  @@unique([companyId, name, effectiveFrom])
  @@index([companyId, status])
}

model Brand {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(32)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(300)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, code])
  @@unique([companyId, name])
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(32)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(300)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  subCategories SubCategory[]
  products      Product[]

  @@unique([companyId, code])
  @@unique([companyId, name])
}

model SubCategory {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  categoryId  String       @db.Uuid
  code        String       @db.VarChar(32)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(300)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  products Product[]

  @@unique([companyId, categoryId, code])
  @@unique([companyId, categoryId, name])
}

model Product {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  code            String              @db.VarChar(40)
  name            String              @db.VarChar(180)
  description     String?             @db.VarChar(500)
  brandId         String?             @db.Uuid
  categoryId      String              @db.Uuid
  subCategoryId   String?             @db.Uuid
  unitId          String              @db.Uuid
  hsnCodeId       String?             @db.Uuid
  taxRateId       String?             @db.Uuid
  trackingType    ProductTrackingType @default(NONE)
  reorderLevel    Decimal             @default(0) @db.Decimal(14, 3)
  status          RecordStatus        @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  subCategory SubCategory?     @relation(fields: [subCategoryId], references: [id])
  unit        Unit             @relation(fields: [unitId], references: [id])
  hsnCode     HsnCode?         @relation(fields: [hsnCodeId], references: [id])
  taxRate     TaxRate?         @relation(fields: [taxRateId], references: [id])
  variants    ProductVariant[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([companyId, status])
}

model ProductVariant {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  productId   String       @db.Uuid
  code        String       @db.VarChar(48)
  name        String       @db.VarChar(160)
  barcode     String?      @db.VarChar(80)
  salePrice   Decimal      @default(0) @db.Decimal(14, 2)
  purchasePrice Decimal    @default(0) @db.Decimal(14, 2)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  stockBalances StockBalance[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@index([companyId, productId, status])
}

model Warehouse {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(32)
  name        String       @db.VarChar(120)
  address     String?      @db.VarChar(300)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  blocks  WarehouseBlock[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@unique([companyId, name])
}

model WarehouseBlock {
  id          String       @id @default(uuid()) @db.Uuid
  warehouseId String       @db.Uuid
  code        String       @db.VarChar(32)
  name        String       @db.VarChar(120)
  blockType   String       @default("Storage") @db.VarChar(40)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  racks     WarehouseRack[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]

  @@unique([warehouseId, code])
  @@unique([warehouseId, name])
}

model WarehouseRack {
  id        String       @id @default(uuid()) @db.Uuid
  blockId   String       @db.Uuid
  code      String       @db.VarChar(32)
  name      String       @db.VarChar(120)
  rackType  String       @default("Open") @db.VarChar(40)
  shelfCount Int         @default(1)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  block   WarehouseBlock  @relation(fields: [blockId], references: [id])
  shelves WarehouseShelf[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]

  @@unique([blockId, code])
  @@unique([blockId, name])
}

model WarehouseShelf {
  id        String       @id @default(uuid()) @db.Uuid
  rackId    String       @db.Uuid
  code      String       @db.VarChar(32)
  name      String       @db.VarChar(120)
  barcode   String?      @db.VarChar(80)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  rack WarehouseRack @relation(fields: [rackId], references: [id])
  stockBalances StockBalance[]
  stockMovements StockMovement[]

  @@unique([rackId, code])
  @@unique([rackId, name])
  @@unique([barcode])
}

model StockBalance {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String   @db.Uuid
  warehouseId      String   @db.Uuid
  blockId          String?  @db.Uuid
  rackId           String?  @db.Uuid
  shelfId          String?  @db.Uuid
  locationKey      String   @db.VarChar(180)
  quantity         Decimal  @default(0) @db.Decimal(14, 3)
  averageCost      Decimal  @default(0) @db.Decimal(14, 2)
  stockValue       Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt        DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  block          WarehouseBlock? @relation(fields: [blockId], references: [id])
  rack           WarehouseRack?  @relation(fields: [rackId], references: [id])
  shelf          WarehouseShelf? @relation(fields: [shelfId], references: [id])

  @@unique([companyId, productVariantId, warehouseId, locationKey])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  productId        String            @db.Uuid
  productVariantId String            @db.Uuid
  warehouseId      String            @db.Uuid
  blockId          String?           @db.Uuid
  rackId           String?           @db.Uuid
  shelfId          String?           @db.Uuid
  locationKey      String            @db.VarChar(180)
  movementType     StockMovementType
  documentType     String            @db.VarChar(80)
  documentNumber   String            @db.VarChar(80)
  documentDate     DateTime          @db.Date
  quantityIn       Decimal           @default(0) @db.Decimal(14, 3)
  quantityOut      Decimal           @default(0) @db.Decimal(14, 3)
  unitCost         Decimal           @default(0) @db.Decimal(14, 2)
  totalValue       Decimal           @default(0) @db.Decimal(14, 2)
  narration        String?           @db.VarChar(500)
  createdByUserId  String?           @db.Uuid
  createdAt        DateTime          @default(now())

  company        Company         @relation(fields: [companyId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  block          WarehouseBlock? @relation(fields: [blockId], references: [id])
  rack           WarehouseRack?  @relation(fields: [rackId], references: [id])
  shelf          WarehouseShelf? @relation(fields: [shelfId], references: [id])

  @@index([companyId, productVariantId, createdAt])
  @@index([companyId, documentType, documentNumber])
  @@index([companyId, warehouseId, createdAt])
}

model Customer {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(40)
  name        String       @db.VarChar(180)
  customerType String      @default("Retail") @db.VarChar(40)
  phone       String?      @db.VarChar(32)
  email       String?      @db.VarChar(160)
  gstin       String?      @db.VarChar(15)
  pan         String?      @db.VarChar(10)
  creditLimit Decimal      @default(0) @db.Decimal(14, 2)
  creditDays  Int          @default(0)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  vehicles Vehicle[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([companyId, phone])
}

model Supplier {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(40)
  name        String       @db.VarChar(180)
  supplierType String      @default("Distributor") @db.VarChar(40)
  phone       String?      @db.VarChar(32)
  email       String?      @db.VarChar(160)
  gstin       String?      @db.VarChar(15)
  pan         String?      @db.VarChar(10)
  creditDays  Int          @default(0)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([companyId, phone])
}

model Employee {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(40)
  name        String       @db.VarChar(180)
  designation String?      @db.VarChar(120)
  department  String?      @db.VarChar(80)
  phone       String?      @db.VarChar(32)
  email       String?      @db.VarChar(160)
  joiningDate DateTime?    @db.Date
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, name])
}

model Vehicle {
  id                 String       @id @default(uuid()) @db.Uuid
  companyId          String       @db.Uuid
  customerId         String?      @db.Uuid
  registrationNumber String       @db.VarChar(40)
  chassisNumber      String?      @db.VarChar(80)
  engineNumber       String?      @db.VarChar(80)
  vehicleType        String       @default("Four-wheeler") @db.VarChar(40)
  brand              String       @db.VarChar(120)
  model              String       @db.VarChar(120)
  variant            String?      @db.VarChar(120)
  fuelType           String?      @db.VarChar(40)
  odometerReading    Int          @default(0)
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([companyId, registrationNumber])
  @@unique([companyId, chassisNumber])
  @@unique([companyId, engineNumber])
  @@index([companyId, brand, model])
}

model PaymentMode {
  id                String       @id @default(uuid()) @db.Uuid
  companyId          String       @db.Uuid
  code              String       @db.VarChar(40)
  name              String       @db.VarChar(120)
  paymentType       String       @db.VarChar(40)
  requiresReference Boolean      @default(false)
  isDefault         Boolean      @default(false)
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@unique([companyId, name])
}
